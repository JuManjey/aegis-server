# AEGIS relay — пример конфигурации (§12.2). Скопируйте в `.env` и при необходимости
# отредактируйте. `.env` НЕ коммитить (см. .gitignore).
#
# Сервер zero-trust (§10.9): секретов тут нет — только лимиты ресурсов. Все
# значения имеют безопасные умолчания, файл можно оставить почти пустым.

# Адрес привязки HTTP ВНУТРИ контейнера (наружу порт не публикуется — только Tor HS).
AEGIS_BIND=0.0.0.0:8080

# Путь к SQLite (durable offline-очередь). В контейнере — том /data.
AEGIS_DB=/data/aegis-relay.db

# Максимальный размер тела POST (байт). Конверт сообщения невелик.
AEGIS_MAX_BODY_BYTES=65536

# Максимум конвертов в одной очереди mailbox (защита от переполнения).
AEGIS_MAX_QUEUE=1000

# ГЛОБАЛЬНЫЕ потолки хранения конвертов. ВАЖНО: AEGIS_MAX_QUEUE ограничивает
# только ОДНУ очередь, поэтому без этих двух лимитов любой, кто знает
# onion-адрес, забивал диск дропами в неограниченное число НОВЫХ ящиков
# (sweeper удаляет лишь просроченные — через 7 суток). При превышении
# вытесняются самые старые конверты по всей БД.
AEGIS_MAX_TOTAL_MESSAGES=200000
AEGIS_MAX_TOTAL_BYTES=536870912

# Срок хранения конвертов (сек). Жёсткий потолок — 7 суток (§7.3), больше нельзя.
AEGIS_TTL_SECS=604800

# Максимальная длительность long-poll ожидания (сек).
AEGIS_MAX_WAIT_SECS=30

# Максимум конвертов, возвращаемых за один poll.
AEGIS_POLL_LIMIT=256

# --- Вложения и голосовые сообщения (§14.4) ---------------------------------
# Максимальный размер одного зашифрованного блоба вложения (байт). Клиент сам
# не даёт выбрать вложение крупнее 8 МБ, запас — на служебные поля каскада.
# Голосовые в этот лимит укладываются с огромным запасом: минута записи в
# AAC-LC 24 кбит/с ≈ 180 КБ, потолок длительности — 5 минут (≈ 0.9 МБ).
AEGIS_BLOB_MAX_BYTES=12582912

# Максимум блобов в хранилище ПО ЧИСЛУ (вытеснение самых старых при превышении).
AEGIS_MAX_BLOBS=2000

# Максимум блобов ПО СУММАРНОМУ ОБЪЁМУ (байт). Нужен обязательно: потолок по
# числу сам по себе диск не защищает — AEGIS_MAX_BLOBS × AEGIS_BLOB_MAX_BYTES
# это до 24 ГиБ, тогда как у конвертов байтовый потолок равен 512 МиБ. То есть
# без этого лимита вложения были единственным способом переполнить диск, зная
# только onion-адрес. При превышении вытесняются самые старые блобы.
#
# Второй эффект, важный именно для голосовых: они мелкие и частые, поэтому
# переписка голосом упирается в лимит КОЛИЧЕСТВА, заняв доли процента места, и
# вытесняет чужие ещё не скачанные вложения. Байтовый потолок делает вытеснение
# пропорциональным реально занятому диску.
AEGIS_MAX_BLOB_BYTES_TOTAL=1073741824

# --- TURN для медиа звонков (§7.5/§12.2) ------------------------------------
# Общий секрет релея и coturn (TURN REST API, coturn use-auth-secret). Это
# ЕДИНСТВЕННЫЙ настоящий секрет сервера — сгенерируйте длинный случайный:
#   openssl rand -hex 32
# Клиенту он НЕ раскрывается (тот получает эфемерные производные креды).
# TURN включён, когда задан секрет И хотя бы один адрес: onion (AEGIS_TURN_ONION)
# и/или клирнет (AEGIS_TURN_PUBLIC_URIS ниже). Иначе GET /v1/turn → 404 и
# звонки не начинаются: в режиме Tor медиа идёт только через этот TURN.
AEGIS_TURN_SECRET=

# Onion-адрес v3 coturn. Появится ПОСЛЕ первого запуска в
#   docker compose exec tor cat /var/lib/tor/aegis-turn/hostname
# Скопируйте сюда и перезапустите relay (docker compose up -d relay).
AEGIS_TURN_ONION=

# TCP-порт coturn на onion (совпадает с HiddenServicePort в torrc).
AEGIS_TURN_PORT=3478

# Срок жизни эфемерных TURN-кред (сек). Кап — 7 суток (§7.3).
AEGIS_TURN_TTL_SECS=3600

# Realm coturn (информативно).
AEGIS_TURN_REALM=aegis

# --- ПУБЛИЧНЫЙ STUN для ПРЯМЫХ звонков (§7.5) — УСТАРЕВШИЙ ПУТЬ ----------------
#
# Нужен только старым версиям клиента (переключатель «медиапоток через Tor»).
# Новые клиенты в режиме «Tor ВЫКЛ» берут STUN/TURN из AEGIS_TURN_PUBLIC_URIS
# (клирнет-профиль ниже), а это поле используют лишь как запасное. При
# клирнет-профиле можно задать AEGIS_STUN_PUBLIC=<домен>:3478 — порт уже открыт,
# docker-compose.stun.yml при этом НЕ подключать (оба публикуют 3478/udp).
#
# Пусто (по умолчанию) = STUN не раздаётся, всё как раньше: прямого пути между
# абонентами не существует, медиа всегда идёт через onion-ретранслятор.
#
# Зачем включать: без STUN абонент не может узнать свой адрес снаружи NAT, а
# значит прямое соединение невозможно в принципе. С STUN звонки между разными
# сетями идут напрямую — заметно ниже задержка и никакой нагрузки на ваш сервер.
#
# ЧЕМ ЗА ЭТО ПЛАТИМ, честно: клиент, обратившийся к STUN, раскрывает этому
# серверу свой реальный IP. Приложение делает это ТОЛЬКО когда пользователь сам
# выключил «медиапоток через Tor» — то есть уже согласился на прямое соединение
# и уже раскрывает IP собеседнику (так работает любой P2P-звонок, в том числе в
# Signal). В анонимном режиме STUN не запрашивается вовсе. Шифрование не
# затрагивается: STUN не участвует в передаче медиа, поток остаётся под
# DTLS-SRTP с кодом сверки.
#
# Значение — адрес, по которому сервер РЕАЛЬНО достижим снаружи (домен или IP)
# плюс порт. Пример: AEGIS_STUN_PUBLIC=203.0.113.10:3478
#
# Включение требует ТРЁХ шагов, по отдельности бесполезных (см. README.md,
# раздел «Публичный STUN»): открыть 3478/udp в файрволе, задать эту переменную, поднять стек с
# docker-compose.stun.yml.
AEGIS_STUN_PUBLIC=

# На каком адресе хоста слушать публичный STUN. По умолчанию все интерфейсы;
# сузьте, если у сервера несколько адресов и наружу смотрит только один.
AEGIS_STUN_BIND=0.0.0.0

# --- Клирнет-профиль: клиенты в режиме «Tor ВЫКЛ» (docker-compose.clearnet.yml) --
#
# Используется ТОЛЬКО вместе с docker-compose.clearnet.yml (README.md, раздел «Клирнет-профиль»).
# Без него переменные ниже ни на что не влияют, кроме AEGIS_TURN_PUBLIC_URIS:
# релей отдаст эти адреса клиентам, а без опубликованных портов они не работают.
#
# Что меняется для приватности: клиенты без Tor приходят с реальных IP (они
# согласились на это в диалоге выключения Tor). Журналы адресов не пишут:
# у Caddy нет журнала доступа, журнал coturn выключен, релей адресов не видит.
# Шифрование не меняется — сервер по-прежнему видит только шифртекст.

# Домен HTTPS-фронта релея. Caddy сам получает для него сертификат Let's Encrypt
# и продлевает его. Нужна A-запись домена на этот сервер и открытые 80/443 TCP.
# Этот же адрес (https://<домен>) подписывается в конфиг (--relay-https) и/или
# зашивается в сборку клиента (aegis.defaultRelayHttps).
AEGIS_RELAY_DOMAIN=

# Домен сертификата для TURNS (5349). Пусто = AEGIS_RELAY_DOMAIN. Если другой —
# добавьте для него отдельный сайт в docker/caddy/Caddyfile, иначе Caddy не
# выпустит для него сертификат.
AEGIS_TURN_DOMAIN=

# Клирнет ICE-адреса своего coturn для клиентов без Tor — поле `uris` в
# GET /v1/turn. Через запятую, схемы stun:/turn:/turns:, хост — домен релея
# (клиент отбрасывает адреса на чужих доменах). Пример для одного домена:
#   AEGIS_TURN_PUBLIC_URIS=stun:relay.example.com:3478,turn:relay.example.com:3478?transport=udp,turn:relay.example.com:3478?transport=tcp,turns:relay.example.com:5349?transport=tcp
# Некорректные элементы релей отбрасывает и пишет об этом в журнал при запуске.
AEGIS_TURN_PUBLIC_URIS=

# На каком адресе хоста публиковать 80/443 (Caddy) и 3478/5349 (coturn).
AEGIS_HTTPS_BIND=0.0.0.0
AEGIS_TURN_BIND=0.0.0.0

# --- Авто-раздача адреса релея клиенту (GET /v1/config, §12.2) --------------
# Чтобы пользователи НЕ вводили onion-адрес релея вручную, клиент периодически
# тянет подписанный конфиг-документ. Документ подписывается ОФЛАЙН-ключом Ed25519
# (приватный ключ НИКОГДА не кладётся на сервер — zero-trust, §10.9), а клиент
# проверяет подпись зашитым в APK публичным ключом. Обе строки ниже генерирует
# офлайн-инструмент на доверенной машине:
#
#   1) один раз сгенерировать ключ (публичную часть зашить в клиент при сборке):
#        cargo run --features tools --bin aegis-config-sign -- keygen
#   2) подписать адрес(а) релея (см. onion релея: cat /var/lib/tor/aegis/hostname):
#        cargo run --features tools --bin aegis-config-sign -- sign \
#            --key <PRIVATE_KEY_HEX> \
#            --relay <hs>.onion \
#            --turn <turn-hs>.onion --turn-port 3478 \
#            --version 1 --min-app 2
#   3) вставить полученные строки сюда и перезапустить relay:
#        docker compose up -d relay
#
# Пусто = GET /v1/config вернёт 404, клиент останется на зашитом в сборку адресе.
# Ротация адреса: увеличить --version (клиент отвергает старую версию) и переподписать.
AEGIS_CONFIG_DOC=
AEGIS_CONFIG_SIG=

# --- Каталог обнаружения: удалённое добавление контакта ---------------------
# (см. aegis-client/docs/contact_requests.md и PROTOCOL.md §4.7)
#
# ПРИВАТНЫЙ каталог. Записи запечатаны клиентом (AEAD на ключе, выведенном из
# 256-битного тега обнаружения владельца — сервер тега не знает и запись НЕ
# читает), а индекс выведен из того же тега, поэтому каталог НЕПЕРЕЧИСЛИМ и не
# раскрывает ни ников, ни ключей, ни того, кто кого искал. Это основной путь
# удалённого добавления; можно оставить включённым.
# 0 = маршруты /v1/directory/* вернут 404, клиенты откатятся на QR/NFC.
AEGIS_DIRECTORY_ENABLED=1

# Максимум записей каталога (вытеснение самых старых).
AEGIS_MAX_DIRECTORY=100000

# Максимальный размер одной запечатанной записи (байт). Внутри — идентити-ключи
# и prekey-бандлы устройств (Kyber1024 ≈ 2.9 КБ на устройство).
AEGIS_DIRECTORY_MAX_BYTES=16384

# Максимальный срок публикации записи (сек), клемпит присланный клиентом ?ttl=.
AEGIS_DIRECTORY_MAX_TTL_SECS=7776000

# ПУБЛИЧНЫЕ АЛИАСЫ (`@ник`). ВЫКЛЮЧЕНЫ ПО УМОЛЧАНИЮ — ОСОЗНАННО.
#
# Публичное пространство имён ПЕРЕЧИСЛИМО ПО ПОСТРОЕНИЮ: индекс это
# HKDF(нормализованный_ник), а ник низкоэнтропиен, поэтому словарная атака по
# популярным никам возможна всегда и скрыть это нельзя. Что при этом НЕ
# утекает: ключи, prekey-бандлы, кто кого искал (запись алиаса содержит только
# accountId + указатель на приватный каталог). Подмена ключей невозможна:
# заявка подписана Ed25519, а accountId в ней — коммитмент к тому же ключу,
# и клиент перепроверяет это сам.
#
# Включайте, если хотите UX «добавить по нику». Приватный каталог по адресу
# работает независимо и остаётся более приватным путём.
AEGIS_ALIAS_ENABLED=0

# Максимум заявок на алиасы.
AEGIS_MAX_ALIASES=100000

# Сложность proof-of-work (ведущих нулевых битов SHA-256) на маршрутах алиасов.
# Лимит по IP за Tor бесполезен (все запросы идут от локального tor-демона с
# одного адреса), поэтому перечисление сдерживается работой. 20 бит ≈ доли
# секунды на одно действие пользователя и миллионы секунд на словарный перебор.
# 0 = выключить (не рекомендуется при AEGIS_ALIAS_ENABLED=1). Потолок — 32.
AEGIS_POW_BITS=20

# Уровень логирования (без чувствительных данных).
RUST_LOG=aegis_relay=info,tower_http=info
